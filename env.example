# OpenAI Configuration (IF YOU USE IT)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini Configuration (IF YOU USE IT)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter Configuration (IF YOU USE IT)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GROQ (IF YOU USE IT)
GROQ_API_KEY=your_groq_api_key_here

# LiteLLM Configuration
LITELLM_BASE_URL=http://litellm:4000
LITELLM_LOG=INFO

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000

# Optional host-port overrides (useful when another project already uses a port)
API_PORT=8000
LITELLM_PORT=8001
MLFLOW_PORT=5001
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
TEI_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# TEI needs an explicit resolver on Docker setups where the embedded DNS fails.
TEI_DNS_PRIMARY=1.1.1.1
TEI_DNS_SECONDARY=8.8.8.8
